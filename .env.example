# compose 环境变量模板：复制为 .env 并改成真实值（.env 不要提交到仓库）
DB_PASSWORD=改成强密码
# JWT 签名密钥：至少 32 个字符的随机串
JWT_SECRET=改成至少32字符的随机串
# 前端容器对外端口（公司网关 443 的 /ldxq/ 转发到此端口）
WEB_PORT=18080
# 后端容器对外端口（公司网关 8089 的 /ldxq_backend/ 转发到此端口）
BACKEND_PORT=18081
# 允许跨域调用接口的前端来源（浏览器页面的来源，不含端口 8089）
CORS_ORIGINS=https://maas-dev.chinasatnet.com.cn
